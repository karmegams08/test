{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "signal-vs-reality",
  "main": "worker.js",
  "compatibility_date": "2026-10-23",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "signal-vs-reality",
      "database_id": "REPLACE_WITH_CLOUDFLARE_D1_DATABASE_ID"
    }
  ]
}